# Environment variables must be exported before starting uvicorn.
CALLSHIELD_DATA_DIR=./runtime
# Shared deployment token; leave empty only for loopback development.
CALLSHIELD_API_TOKEN=
CALLSHIELD_ASR_ENABLED=false
CALLSHIELD_ASR_MODEL=base
# Optional semantic intent agent. Disabled by default.
CALLSHIELD_LLM_ENABLED=false
OPENAI_API_KEY=
CALLSHIELD_LLM_MODEL=gpt-4.1-mini
